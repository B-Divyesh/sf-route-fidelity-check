{
  "name": "route-fidelity-check",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "npm run build && node scripts/browser-regressions.mjs",
    "test:claims": "npm run build && playwright test tests/claims.spec.ts",
    "test:all": "npm test && npm run test:browser && npm run test:claims",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.58.2",
    "playwright": "1.58.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
